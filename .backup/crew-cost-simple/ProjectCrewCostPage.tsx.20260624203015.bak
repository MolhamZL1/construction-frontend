import { type FormEvent, useMemo, useState } from 'react'
import { Link, useParams } from 'react-router-dom'
import { useMutation } from '@tanstack/react-query'
import { AxiosError } from 'axios'
import { api } from '@/lib/axios'
import { ProjectDetailErrorState } from '../components/project-detail/ProjectDetailErrorState'
import { ProjectDetailIcon } from '../components/project-detail/ProjectDetailIcons'

type CrewCostType = 'plaster' | 'paint' | 'tile'

type FormulaValues = Record<string, number | string | null | undefined>

interface CrewCostResponseData {
  project?: {
    id: number | string
    name: string
  }
  formula?: FormulaValues
  pricing?: {
    price_per_meter?: number | string | null
    sink_installation_cost?: number | string | null
    final_cost?: number | string | null
  }
}

interface CrewCostApiResponse {
  status: number
  message: string
  data: CrewCostResponseData
}

interface CrewCostInput {
  projectId: string
  type: CrewCostType
  pricePerMeter: string
  beamsCount: string
  skirtingFactor: string
  sinkInstallationCost: string
}

interface ApiErrorResponse {
  message?: string
  errors?: Record<string, string[]>
  data?: {
    errors?: Record<string, string[]>
  }
}

const calculators: Array<{
  type: CrewCostType
  title: string
  subtitle: string
  endpointLabel: string
  icon: 'calculator' | 'ruler' | 'materials'
  accent: string
  badge: string
}> = [
  {
    type: 'plaster',
    title: 'ورشة اللياسة / الطينة',
    subtitle: 'حساب المساحات المحسوبة للجدران، الجسور والأسقف ثم ضربها بسعر المتر.',
    endpointLabel: 'Plaster Engine',
    icon: 'ruler',
    accent: 'from-[#50683f] to-emerald-500',
    badge: 'مساحات + جسور',
  },
  {
    type: 'paint',
    title: 'ورشة الدهان',
    subtitle: 'نفس منطق المساحات مع طبقات الأسقف والجدران للوصول لأجرة الدهان.',
    endpointLabel: 'Paint Engine',
    icon: 'calculator',
    accent: 'from-purple-600 to-fuchsia-500',
    badge: 'جدران + أسقف',
  },
  {
    type: 'tile',
    title: 'ورشة البلاط والسيراميك',
    subtitle: 'حساب أرضيات، سيراميك، سكيرتنج وتكلفة تركيب المغاسل ضمن معادلة واحدة.',
    endpointLabel: 'Tile Engine',
    icon: 'materials',
    accent: 'from-orange-500 to-amber-400',
    badge: 'بلاط + سكيرتنج',
  },
]

const formulaLabels: Record<string, string> = {
  wall_area: 'مساحة الجدران',
  beams_count: 'عدد الجسور',
  beams_area: 'مساحة الجسور',
  apartment_ceiling_area_x2: 'مساحة أسقف الشقق × 2',
  shed_ceiling_area_x2: 'مساحة أسقف المناور × 2',
  apartment_area: 'مساحة الشقق',
  shed_tiled_area: 'مساحة المناور المبلطة',
  ceramic_wall_area: 'مساحة سيراميك الجدران',
  ceramic_ceiling_area_x2: 'مساحة سيراميك الأسقف × 2',
  skirting_factor: 'معامل السكيرتنج',
  skirting_area: 'مساحة السكيرتنج',
  total_area: 'المساحة الإجمالية المحسوبة',
}

function formatNumber(value: number | string | null | undefined) {
  const numberValue = Number(value ?? 0)

  if (!Number.isFinite(numberValue)) {
    return '0'
  }

  return new Intl.NumberFormat('ar-SY', {
    maximumFractionDigits: 2,
    minimumFractionDigits: Number.isInteger(numberValue) ? 0 : 2,
  }).format(numberValue)
}

function formatCurrency(value: number | string | null | undefined) {
  return `${formatNumber(value)} ل.س`
}

function getFirstValidationMessage(errors?: Record<string, string[]>) {
  return errors ? Object.values(errors)[0]?.[0] : null
}

function getCrewCostErrorMessage(error: unknown) {
  if (!(error instanceof AxiosError)) {
    return 'حدث خطأ غير متوقع أثناء حساب أجرة الورشة.'
  }

  const responseData = error.response?.data as ApiErrorResponse | undefined
  const validationMessage = getFirstValidationMessage(responseData?.errors) ?? getFirstValidationMessage(responseData?.data?.errors)

  if (validationMessage) {
    return validationMessage
  }

  return responseData?.message ?? 'تعذر حساب أجرة الورشة. تحقق من القيم ثم أعد المحاولة.'
}

async function calculateCrewCost(input: CrewCostInput) {
  const formData = new FormData()
  formData.append('price_per_meter', input.pricePerMeter)

  if (input.type === 'tile') {
    formData.append('skirting_factor', input.skirtingFactor)
    formData.append('sink_installation_cost', input.sinkInstallationCost)
  } else {
    formData.append('beams_count', input.beamsCount)
  }

  const { data } = await api.post<CrewCostApiResponse>(`/projects/${input.projectId}/${input.type}`, formData, {
    headers: {
      Accept: 'application/json',
    },
  })

  return data.data
}

function FormulaLoadingOverlay({ activeCalculator }: { activeCalculator: (typeof calculators)[number] }) {
  const steps = [
    'قراءة مساحات المشروع من المخطط',
    'تحليل الجدران، الأسقف والجسور',
    'تطبيق معاملات الورشة على كل بند',
    'تجميع المساحات وتوليد التكلفة النهائية',
  ]

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/55 px-4 backdrop-blur-sm" dir="rtl">
      <div className="relative w-full max-w-2xl overflow-hidden rounded-[2rem] border border-white/20 bg-white shadow-[0_30px_90px_rgba(15,23,42,0.35)]">
        <div className={`absolute inset-x-0 top-0 h-1.5 bg-gradient-to-l ${activeCalculator.accent}`} />
        <div className="absolute -left-24 -top-24 h-52 w-52 rounded-full bg-[#50683f]/15 blur-3xl" />
        <div className="absolute -bottom-24 -right-20 h-60 w-60 rounded-full bg-orange-300/20 blur-3xl" />

        <div className="relative space-y-7 p-7 sm:p-9">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p className="text-xs font-black uppercase tracking-[0.35em] text-[#50683f]">{activeCalculator.endpointLabel}</p>
              <h2 className="mt-2 text-2xl font-black text-slate-950">محرك المعادلات يعمل الآن</h2>
              <p className="mt-2 text-sm font-bold leading-7 text-slate-500">عم نحسب أجرة الورشة بناءً على مساحات المشروع والمعاملات المدخلة، لحظة واحدة...</p>
            </div>
            <div className="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl bg-slate-950 text-white shadow-2xl">
              <div className="absolute inset-2 rounded-2xl border border-white/20" />
              <div className="absolute inset-0 animate-spin rounded-3xl border-2 border-transparent border-t-white/80" />
              <span className="text-2xl font-black">Σ</span>
            </div>
          </div>

          <div className="rounded-3xl border border-slate-200 bg-slate-950 p-5 text-left shadow-inner" dir="ltr">
            <div className="mb-4 flex items-center gap-2">
              <span className="h-3 w-3 rounded-full bg-red-400" />
              <span className="h-3 w-3 rounded-full bg-amber-300" />
              <span className="h-3 w-3 rounded-full bg-emerald-400" />
            </div>
            <div className="space-y-3 font-mono text-sm font-bold text-emerald-200">
              <p className="animate-pulse">wallArea + beamsArea + ceilingArea × 2</p>
              <p className="animate-pulse [animation-delay:120ms]">totalArea = Σ(calculated surfaces)</p>
              <p className="animate-pulse [animation-delay:240ms]">finalCost = totalArea × pricePerMeter + extras</p>
            </div>
          </div>

          <div className="grid gap-3 sm:grid-cols-2">
            {steps.map((step, index) => (
              <div key={step} className="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white/85 p-3 shadow-sm">
                <span className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-l ${activeCalculator.accent} text-sm font-black text-white shadow-lg`}>
                  {index + 1}
                </span>
                <div className="min-w-0 flex-1">
                  <p className="text-sm font-extrabold text-slate-800">{step}</p>
                  <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-100">
                    <div className="h-full w-2/3 animate-pulse rounded-full bg-slate-900" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )
}

function ResultMetric({ label, value, hint }: { label: string; value: string; hint?: string }) {
  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_12px_30px_rgba(15,23,42,0.06)]">
      <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-400">{label}</p>
      <p className="mt-2 text-2xl font-black text-slate-950">{value}</p>
      {hint ? <p className="mt-2 text-xs font-bold text-slate-500">{hint}</p> : null}
    </div>
  )
}

export function ProjectCrewCostPage() {
  const { id } = useParams<{ id: string }>()
  const [selectedType, setSelectedType] = useState<CrewCostType>('plaster')
  const [pricePerMeter, setPricePerMeter] = useState('22')
  const [beamsCount, setBeamsCount] = useState('22')
  const [skirtingFactor, setSkirtingFactor] = useState('2')
  const [sinkInstallationCost, setSinkInstallationCost] = useState('0')
  const [resultType, setResultType] = useState<CrewCostType>('plaster')

  const activeCalculator = useMemo(
    () => calculators.find((calculator) => calculator.type === selectedType) ?? calculators[0],
    [selectedType]
  )

  const resultCalculator = useMemo(
    () => calculators.find((calculator) => calculator.type === resultType) ?? calculators[0],
    [resultType]
  )

  const calculateMutation = useMutation({
    mutationFn: calculateCrewCost,
    onSuccess: () => setResultType(selectedType),
  })

  const result = calculateMutation.data
  const finalCost = result?.pricing?.final_cost
  const totalArea = result?.formula?.total_area
  const priceValue = result?.pricing?.price_per_meter
  const formulaEntries = Object.entries(result?.formula ?? {}).filter(([key]) => key !== 'beams_count' || resultType !== 'tile')
  const errorMessage = calculateMutation.error ? getCrewCostErrorMessage(calculateMutation.error) : null

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()

    if (!id) {
      return
    }

    calculateMutation.mutate({
      projectId: id,
      type: selectedType,
      pricePerMeter,
      beamsCount,
      skirtingFactor,
      sinkInstallationCost,
    })
  }

  if (!id) {
    return <ProjectDetailErrorState title="رابط المشروع غير صحيح" description="لم يتم العثور على رقم المشروع ضمن الرابط الحالي." />
  }

  return (
    <section className="min-h-[calc(100vh-4rem)] bg-white px-5 py-7 text-right sm:px-8 lg:px-10" dir="rtl">
      {calculateMutation.isPending ? <FormulaLoadingOverlay activeCalculator={activeCalculator} /> : null}

      <div className="mx-auto max-w-7xl space-y-6">
        <Link to={`/projects/${id}`} className="inline-flex items-center gap-2 text-sm font-extrabold text-slate-500 transition hover:text-[#50683f]">
          <ProjectDetailIcon name="arrow" className="h-5 w-5 rtl:rotate-180" />
          العودة إلى تفاصيل المشروع
        </Link>

        <section className="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-[0_22px_60px_rgba(15,23,42,0.22)] sm:p-8">
          <div className="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[#50683f]/35 blur-3xl" />
          <div className="absolute -bottom-28 right-14 h-72 w-72 rounded-full bg-orange-400/20 blur-3xl" />
          <div className="relative grid gap-7 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
            <div>
              <p className="text-xs font-black uppercase tracking-[0.35em] text-emerald-200">Workshop Cost Intelligence</p>
              <h1 className="mt-3 text-3xl font-black leading-tight sm:text-4xl">حساب أجرة الورش</h1>
              <p className="mt-4 max-w-2xl text-sm font-bold leading-8 text-slate-300">
                واجهة حساب فخمة تقرأ معاملات الورشة، ترسلها للـ API، وتعرض تفاصيل المعادلة والمساحات والتكلفة النهائية بشكل واضح وقوي.
              </p>
            </div>

            <div className="rounded-[1.75rem] border border-white/15 bg-white/10 p-5 backdrop-blur">
              <div className="flex items-center justify-between gap-4">
                <div>
                  <p className="text-xs font-black text-slate-300">المعادلة الأساسية</p>
                  <p className="mt-2 text-xl font-black">التكلفة = المساحة × سعر المتر + الإضافات</p>
                </div>
                <span className="flex h-16 w-16 shrink-0 items-center justify-center rounded-3xl bg-white text-3xl font-black text-slate-950 shadow-2xl">∑</span>
              </div>
              <div className="mt-5 grid grid-cols-3 gap-2 text-center text-xs font-black text-slate-300">
                <span className="rounded-2xl bg-white/10 px-3 py-2">مساحات</span>
                <span className="rounded-2xl bg-white/10 px-3 py-2">معاملات</span>
                <span className="rounded-2xl bg-white/10 px-3 py-2">تكلفة</span>
              </div>
            </div>
          </div>
        </section>

        <section className="grid gap-5 lg:grid-cols-3">
          {calculators.map((calculator) => {
            const isActive = selectedType === calculator.type

            return (
              <button
                key={calculator.type}
                type="button"
                onClick={() => {
                  setSelectedType(calculator.type)
                  calculateMutation.reset()
                }}
                className={`group rounded-[1.75rem] border p-5 text-right transition hover:-translate-y-0.5 hover:shadow-[0_18px_45px_rgba(15,23,42,0.11)] ${
                  isActive ? 'border-[#50683f]/40 bg-[#50683f]/5 ring-4 ring-[#50683f]/10' : 'border-slate-200 bg-white'
                }`}
              >
                <div className="flex items-start justify-between gap-4">
                  <span className={`flex h-14 w-14 items-center justify-center rounded-3xl bg-gradient-to-l ${calculator.accent} text-white shadow-lg`}>
                    <ProjectDetailIcon name={calculator.icon} className="h-7 w-7" />
                  </span>
                  <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-500">{calculator.badge}</span>
                </div>
                <h2 className="mt-5 text-xl font-black text-slate-950">{calculator.title}</h2>
                <p className="mt-2 text-sm font-bold leading-7 text-slate-500">{calculator.subtitle}</p>
              </button>
            )
          })}
        </section>

        <section className="grid gap-6 xl:grid-cols-[0.9fr_1.1fr]">
          <form onSubmit={handleSubmit} className="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.08)] sm:p-7">
            <div className="flex items-start gap-4">
              <span className={`flex h-14 w-14 shrink-0 items-center justify-center rounded-3xl bg-gradient-to-l ${activeCalculator.accent} text-white shadow-lg`}>
                <ProjectDetailIcon name={activeCalculator.icon} className="h-7 w-7" />
              </span>
              <div>
                <p className="text-xs font-black uppercase tracking-[0.2em] text-slate-400">{activeCalculator.endpointLabel}</p>
                <h2 className="mt-1 text-2xl font-black text-slate-950">{activeCalculator.title}</h2>
                <p className="mt-2 text-sm font-bold leading-7 text-slate-500">أدخل أسعار الورشة، والباقي يتم حسابه من مساحات المشروع في الخلفية.</p>
              </div>
            </div>

            <div className="mt-7 space-y-4">
              <label className="block">
                <span className="text-sm font-black text-slate-700">سعر المتر</span>
                <input
                  value={pricePerMeter}
                  onChange={(event) => setPricePerMeter(event.target.value)}
                  type="number"
                  min="0"
                  step="0.01"
                  inputMode="decimal"
                  required
                  className="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-right text-lg font-black text-slate-950 outline-none transition focus:border-[#50683f] focus:bg-white focus:ring-4 focus:ring-[#50683f]/10"
                  placeholder="مثال: 22"
                />
              </label>

              {selectedType === 'tile' ? (
                <div className="grid gap-4 sm:grid-cols-2">
                  <label className="block">
                    <span className="text-sm font-black text-slate-700">معامل السكيرتنج</span>
                    <input
                      value={skirtingFactor}
                      onChange={(event) => setSkirtingFactor(event.target.value)}
                      type="number"
                      min="0"
                      step="0.01"
                      inputMode="decimal"
                      required
                      className="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-right text-lg font-black text-slate-950 outline-none transition focus:border-[#50683f] focus:bg-white focus:ring-4 focus:ring-[#50683f]/10"
                      placeholder="مثال: 2"
                    />
                  </label>
                  <label className="block">
                    <span className="text-sm font-black text-slate-700">تكلفة تركيب المغاسل</span>
                    <input
                      value={sinkInstallationCost}
                      onChange={(event) => setSinkInstallationCost(event.target.value)}
                      type="number"
                      min="0"
                      step="0.01"
                      inputMode="decimal"
                      required
                      className="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-right text-lg font-black text-slate-950 outline-none transition focus:border-[#50683f] focus:bg-white focus:ring-4 focus:ring-[#50683f]/10"
                      placeholder="مثال: 22"
                    />
                  </label>
                </div>
              ) : (
                <label className="block">
                  <span className="text-sm font-black text-slate-700">عدد الجسور</span>
                  <input
                    value={beamsCount}
                    onChange={(event) => setBeamsCount(event.target.value)}
                    type="number"
                    min="0"
                    step="1"
                    inputMode="numeric"
                    required
                    className="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-right text-lg font-black text-slate-950 outline-none transition focus:border-[#50683f] focus:bg-white focus:ring-4 focus:ring-[#50683f]/10"
                    placeholder="مثال: 22"
                  />
                </label>
              )}
            </div>

            {errorMessage ? (
              <div className="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold leading-7 text-red-700">{errorMessage}</div>
            ) : null}

            <button
              type="submit"
              disabled={calculateMutation.isPending}
              className="mt-7 flex w-full items-center justify-center gap-3 rounded-2xl bg-slate-950 px-5 py-4 text-base font-black text-white shadow-[0_16px_35px_rgba(15,23,42,0.22)] transition hover:-translate-y-0.5 hover:bg-[#50683f] disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span>{calculateMutation.isPending ? 'جاري تشغيل محرك الحساب...' : 'احسب أجرة الورشة'}</span>
              <span className="text-xl">∑</span>
            </button>
          </form>

          <section className="rounded-[2rem] border border-slate-200 bg-slate-50/70 p-5 shadow-[0_18px_50px_rgba(15,23,42,0.06)] sm:p-7">
            {result ? (
              <div className="space-y-5">
                <div className="rounded-[1.75rem] bg-white p-6 shadow-sm">
                  <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <p className="text-xs font-black uppercase tracking-[0.22em] text-slate-400">نتيجة المعادلة</p>
                      <h2 className="mt-2 text-2xl font-black text-slate-950">{resultCalculator.title}</h2>
                      <p className="mt-2 text-sm font-bold text-slate-500">المشروع: {result.project?.name ?? '—'}</p>
                    </div>
                    <span className={`flex h-14 w-14 items-center justify-center rounded-3xl bg-gradient-to-l ${resultCalculator.accent} text-2xl font-black text-white shadow-lg`}>✓</span>
                  </div>

                  <div className="mt-6 grid gap-4 md:grid-cols-3">
                    <ResultMetric label="التكلفة النهائية" value={formatCurrency(finalCost)} hint="الناتج النهائي من الـ API" />
                    <ResultMetric label="المساحة الإجمالية" value={`${formatNumber(totalArea)} م²`} hint="إجمالي المساحات المحسوبة" />
                    <ResultMetric label="سعر المتر" value={formatCurrency(priceValue)} hint="القيمة المدخلة للحساب" />
                  </div>
                </div>

                <div className="rounded-[1.75rem] border border-slate-200 bg-white p-5">
                  <div className="mb-4 flex items-center justify-between gap-4">
                    <h3 className="text-lg font-black text-slate-950">تفاصيل المعادلة</h3>
                    <span className="rounded-full bg-[#50683f]/10 px-3 py-1 text-xs font-black text-[#50683f]">Formula Breakdown</span>
                  </div>

                  <div className="grid gap-3 sm:grid-cols-2">
                    {formulaEntries.map(([key, value]) => (
                      <div key={key} className="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                        <p className="text-xs font-black text-slate-400">{formulaLabels[key] ?? key}</p>
                        <p className="mt-1 text-xl font-black text-slate-950">{formatNumber(value)}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="rounded-[1.75rem] border border-[#50683f]/20 bg-[#50683f]/5 p-5">
                  <p className="text-sm font-black text-[#50683f]">المعادلة النهائية</p>
                  <p className="mt-2 text-lg font-black leading-8 text-slate-950">
                    {formatNumber(totalArea)} م² × {formatCurrency(priceValue)} = {formatCurrency(finalCost)}
                  </p>
                  {result?.pricing?.sink_installation_cost != null && Number(result.pricing.sink_installation_cost) > 0 ? (
                    <p className="mt-2 text-sm font-bold text-slate-500">تشمل تكلفة تركيب المغاسل: {formatCurrency(result.pricing.sink_installation_cost)}</p>
                  ) : null}
                </div>
              </div>
            ) : (
              <div className="flex min-h-[520px] items-center justify-center rounded-[1.75rem] border border-dashed border-slate-300 bg-white p-8 text-center">
                <div className="max-w-md">
                  <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-[2rem] bg-slate-950 text-4xl font-black text-white shadow-2xl">∑</div>
                  <h2 className="mt-6 text-2xl font-black text-slate-950">جاهز لتشغيل معادلة الورشة</h2>
                  <p className="mt-3 text-sm font-bold leading-7 text-slate-500">
                    اختر نوع الورشة، أدخل القيم المطلوبة، واضغط حساب ليظهر تفصيل التكلفة والمساحات المحسوبة مباشرة.
                  </p>
                </div>
              </div>
            )}
          </section>
        </section>
      </div>
    </section>
  )
}
